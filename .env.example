# Copy to .env and fill in. Loaded automatically by invoice_ingest.config.

# LLM — any OpenAI-compatible endpoint. Examples below use OpenRouter.
LLM_API_KEY=sk-...
LLM_URL=https://openrouter.ai/api/v1
# Any model slug the endpoint serves (defaults to claude-haiku-4.5 if unset), e.g.:
#   anthropic/claude-haiku-4.5   openai/gpt-5.6-luna   anthropic/claude-opus-4.8
LLM_MODEL=anthropic/claude-haiku-4.5

# Path to Tesseract language data (dan/deu/eng). Homebrew shown; on Linux it's often
# /usr/share/tesseract-ocr/5/tessdata
TESSDATA_PREFIX=/opt/homebrew/share/tessdata
# Optional OCR overrides (defaults shown):
# OCR_LANGS=dan+deu+eng
# OCR_RENDER_DPI=300
